{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "Forge – self-hosted developer platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @forge/api",
    "dev:web": "npm run dev --workspace @forge/web",
    "build": "npm run build --workspace @forge/shared && npm run build --workspace @forge/api && npm run build --workspace @forge/web",
    "db:generate": "npm run db:generate --workspace @forge/api",
    "db:migrate": "npm run db:migrate --workspace @forge/api",
    "test": "npm run test --workspace @forge/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
