{
  "name": "@forge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:deployment": "NODE_ENV=production PUBLIC_API_URL=https://gothub-q0p7.onrender.com PUBLIC_WEB_URL=https://forge-wuj4.onrender.com vitest run src/__tests__/cross-site.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@forge/shared": "*",
    "@libsql/client": "^0.15.15",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^5.4.2",
    "nodemailer": "^10.2.1",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/ssh2": "^1.15.6",
    "drizzle-kit": "^0.30.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
