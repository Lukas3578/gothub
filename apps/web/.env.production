# Konfiguration für den Produktionsbuild (`vite build`).
#
# Vite liest diese Datei automatisch und setzt den Wert beim Bauen in das
# Bundle ein. Dadurch ist kein Eintrag im Dashboard des Hosting-Anbieters
# nötig – ein Push genügt.
#
# Achtung: Werte hier landen im ausgelieferten JavaScript und sind öffentlich.
# Es darf deshalb ausschließlich die API-Adresse darin stehen, niemals ein
# Geheimnis.
VITE_API_URL=https://gothub-q0p7.onrender.com
